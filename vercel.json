{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/(login|dashboard|detector|detect|algorithm|performance|contact|about|logout)",
      "destination": "/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
