<%- include('header', {title: 'Welcome to SpamShield'}) %>

<div class="animate-fade" style="padding: 4rem 1rem; text-align: center; max-width: 900px; margin: 0 auto;">
    <h1 style="font-size: 3.5rem; font-weight: 800; margin-bottom: 1.5rem; background: linear-gradient(135deg, #fff, var(--text-secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        The Next Generation of <br><span style="color: var(--accent-cyan);">Spam Detection</span>
    </h1>
    <p style="font-size: 1.125rem; color: var(--text-secondary); margin-bottom: 3rem; line-height: 1.7;">
        Harnessing the power of <b>Horspool's String Matching Algorithm</b> to deliver lightning-fast, highly accurate email security for the modern age.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center;">
        <a href="/detector" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1rem;">
            <i class="fas fa-bolt"></i> Start Detection
        </a>
        <a href="/about" class="btn btn-outline" style="padding: 1rem 2.5rem; font-size: 1rem;">
            Explore Algorithm
        </a>
    </div>
</div>

<div class="stats-grid" style="margin-top: 4rem;">
    <div class="card glass animate-fade" style="animation-delay: 0.1s;">
        <div class="brand-icon" style="margin-bottom: 1.5rem; background: rgba(6, 182, 212, 0.1); color: var(--accent-cyan);">
            <i class="fas fa-gauge-high"></i>
        </div>
        <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem;">Optimized Speed</h3>
        <p style="color: var(--text-secondary); font-size: 0.9375rem;">Horspool's algorithm preprocesses patterns to achieve sub-linear time search complexity.</p>
    </div>
    <div class="card glass animate-fade" style="animation-delay: 0.2s;">
        <div class="brand-icon" style="margin-bottom: 1.5rem; background: rgba(147, 51, 234, 0.1); color: var(--accent-purple);">
            <i class="fas fa-shield-virus"></i>
        </div>
        <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem;">Deep Scanning</h3>
        <p style="color: var(--text-secondary); font-size: 0.9375rem;">We match high-risk keywords against global spam signatures to protect your data integrity.</p>
    </div>
    <div class="card glass animate-fade" style="animation-delay: 0.3s;">
        <div class="brand-icon" style="margin-bottom: 1.5rem; background: rgba(99, 102, 241, 0.1); color: var(--accent-indigo);">
            <i class="fas fa-chart-pie"></i>
        </div>
        <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem;">Visual Analytics</h3>
        <p style="color: var(--text-secondary); font-size: 0.9375rem;">View real-time performance metrics and pattern matching visualizations for every scan.</p>
    </div>
</div>

<%- include('footer') %>
