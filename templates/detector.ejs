<%- include('header', {title: 'AI-Powered Spam Shield'}) %>

<div class="animate-fade">
    <div class="detector-wrap">
        <!-- Input Section -->
        <div class="flex flex-col gap-4">
            <div class="card glass shadow-2xl" style="background: rgba(30, 41, 59, 0.5);">
                <h3 style="margin-bottom: 1.5rem; font-size: 1.125rem; font-weight: 700; display: flex; align-items: center; gap: 0.75rem;">
                    <i class="fas fa-file-shield text-accent-cyan"></i> Analysis Workspace
                </h3>
                
                <!-- Drag and Drop Area -->
                <div id="drop-zone" class="drop-zone" style="margin-bottom: 1.5rem;">
                    <i class="fas fa-cloud-arrow-up" style="font-size: 2rem; margin-bottom: 1rem; color: var(--accent-cyan);"></i>
                    <p style="font-size: 0.875rem; color: var(--text-secondary);">Drag and drop <b>.txt</b> or <b>.eml</b> files here</p>
                    <input type="file" id="file-input" style="display: none;" accept=".txt,.eml">
                </div>

                <form action="/detect" method="POST" id="detect-form">
                    <div class="form-group">
                        <label class="form-label">Email Subject</label>
                        <input type="text" name="subject" id="subject-input" class="form-control" placeholder="Target Subject" required value="<%= typeof prefillSubject !== 'undefined' ? prefillSubject : '' %>">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email Content Body</label>
                        <textarea name="content" id="content-textarea" class="form-control" rows="12" placeholder="Paste verification content here..." required style="resize: none; font-family: 'JetBrains Mono', monospace; font-size: 0.875rem;"><%= typeof prefillContent !== 'undefined' ? prefillContent : '' %></textarea>
                    </div>
                    
                    <div style="display: flex; gap: 1rem;">
                        <button type="submit" class="btn btn-primary" style="flex: 1; padding: 1rem;">
                            <i class="fas fa-microchip"></i> Run Engine
                        </button>
                        <% if (result) { %>
                            <button type="button" id="download-pdf" class="btn btn-outline" style="padding: 1rem;">
                                <i class="fas fa-file-pdf"></i> Report
                            </button>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- Heatmap / Comparison Preview (Visible after scan) -->
            <% if (result) { %>
                <div class="card glass animate-fade">
                    <h4 style="font-size: 0.875rem; font-weight: 700; text-transform: uppercase; margin-bottom: 1rem; color: var(--accent-cyan);">Email Heatmap Analysis</h4>
                    <div id="heatmap-preview" style="background: rgba(0,0,0,0.2); padding: 1rem; border-radius: 0.5rem; font-family: monospace; font-size: 0.875rem; max-height: 200px; overflow-y: auto; line-height: 1.6;">
                        <!-- JS will populate this with highlighted text if needed, or we pre-render it -->
                        <% 
                            let highlightedContent = content;
                            const sortedMatches = [...result.matches].sort((a,b) => b.position - a.position);
                            sortedMatches.forEach(match => {
                                const level = result.spamScore > 60 ? 'dangerous' : 'suspicious';
                                highlightedContent = highlightedContent.slice(0, match.position) + 
                                    `<span class="highlight-${level}">${content.slice(match.position, match.position + match.keyword.length)}</span>` + 
                                    highlightedContent.slice(match.position + match.keyword.length);
                            });
                        %>
                        <%- highlightedContent.replace(/\n/g, '<br>') %>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- Result Section -->
        <div class="flex flex-col gap-6">
            <div class="card glass" id="results" style="min-height: 480px; display: flex; flex-direction: column;">
                <h3 style="margin-bottom: 1.5rem; font-size: 1.125rem; font-weight: 700; display: flex; align-items: center; gap: 0.75rem;">
                    <i class="fas fa-bullseye text-accent-indigo"></i> Live Monitoring
                </h3>
                
                <!-- Real-time Score Meter -->
                <div class="score-meter-wrap" style="margin-bottom: 2rem;">
                    <div class="score-circle" id="score-meter" style="--meter-color: #22c55e; --score-deg: <%= result ? (result.spamScore * 3.6) : 0 %>deg;">
                        <div class="score-inner">
                            <span style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);" id="score-text"><%= result ? result.spamScore : 0 %>%</span>
                            <span style="font-size: 0.6rem; text-transform: uppercase; color: var(--text-secondary); font-weight: 700;">Score</span>
                        </div>
                    </div>
                </div>

                <% if (result) { %>
                    <div style="text-align: center; padding: 1.5rem; border-radius: 1rem; background: <%= result.spamScore > 60 ? 'rgba(239, 68, 68, 0.1)' : (result.spamScore > 30 ? 'rgba(234, 179, 8, 0.1)' : 'rgba(34, 197, 94, 0.1)') %>; border: 1px solid <%= result.spamScore > 60 ? 'rgba(239, 68, 68, 0.3)' : (result.spamScore > 30 ? 'rgba(234, 179, 8, 0.3)' : 'rgba(34, 197, 94, 0.3)') %>; margin-bottom: 1.5rem;">
                        <h2 style="color: <%= result.spamScore > 60 ? '#ef4444' : (result.spamScore > 30 ? '#eab308' : '#22c55e') %>; font-size: 1.5rem; font-weight: 800; margin-bottom: 0.25rem;">
                            <%= result.spamScore > 60 ? 'CRITICAL THREAT' : (result.spamScore > 30 ? 'SUSPICIOUS' : 'SECURE ENVELOPE') %>
                        </h2>
                        <p style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600;">Status: <%= result.isSpam ? 'Flagged' : 'Verified' %></p>
                    </div>

                    <!-- AI Assistant Section -->
                    <div class="ai-box animate-fade">
                        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
                            <div style="width: 28px; height: 28px; background: var(--accent-cyan); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; color: white;">
                                <i class="fas fa-robot"></i>
                            </div>
                            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--accent-cyan);">Intelligence Analysis</span>
                        </div>
                        <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6;" id="ai-text">
                            <%= result.explanation %>
                        </p>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.5rem 0;">
                        <div class="glass" style="padding: 1rem; text-align: center; background: rgba(0,0,0,0.2);">
                            <p style="color: var(--text-secondary); font-size: 0.65rem; text-transform: uppercase; font-weight: 800;">Keywords</p>
                            <span style="font-size: 1.25rem; font-weight: 700; color: var(--accent-cyan);"><%= result.keywordCount %></span>
                        </div>
                        <div class="glass" style="padding: 1rem; text-align: center; background: rgba(0,0,0,0.2);">
                            <p style="color: var(--text-secondary); font-size: 0.65rem; text-transform: uppercase; font-weight: 800;">Latency</p>
                            <span style="font-size: 1.25rem; font-weight: 700; color: var(--accent-indigo);"><%= result.executionTime %>ms</span>
                        </div>
                    </div>
                <% } else { %>
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; color: var(--text-secondary);">
                        <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(255,255,255,0.02); display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
                            <i class="fas fa-shield-halved" style="font-size: 2rem; opacity: 0.2;"></i>
                        </div>
                        <h4 style="color: var(--text-primary); margin-bottom: 0.5rem; font-weight: 700;">Shield Standby</h4>
                        <p style="font-size: 0.75rem; line-height: 1.6;">Waiting for data input. Monitoring active.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    // Embed the result to JS context
    window.SCAN_RESULT = <%- JSON.stringify(result || null) %>;
    window.SCAN_CONTENT = `<%= typeof content !== 'undefined' ? content.replace(/`/g, '\\`') : '' %>`;
    window.SCAN_SUBJECT = `<%= typeof subject !== 'undefined' ? subject.replace(/`/g, '\\`') : '' %>`;
</script>
<script src="/js/detector.js"></script>

<%- include('footer') %>
