<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SpamShield - Horspool Algorithm Detection</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <canvas id="matrix-canvas"></canvas>
    <div id="particles-js"></div>
    <div class="app-wrapper">
        <!-- Sidebar -->
        <% if (typeof hideSidebar === 'undefined' || !hideSidebar) { %>
        <aside class="sidebar">
            <a href="/" class="brand">
                <div class="brand-icon">
                    <i class="fas fa-shield-halved text-white"></i>
                </div>
                <span>SPAM SHIELD</span>
            </a>

            <nav class="nav-menu">
                <div class="nav-item">
                    <a href="/" class="nav-link">
                        <i class="fas fa-house"></i>
                        <span>Home</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/about" class="nav-link">
                        <i class="fas fa-circle-info"></i>
                        <span>About</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/dashboard" class="nav-link">
                        <i class="fas fa-gauge-high"></i>
                        <span>Dashboard</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/detector" class="nav-link">
                        <i class="fas fa-magnifying-glass"></i>
                        <span>Detector</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/algorithm" class="nav-link">
                        <i class="fas fa-microchip"></i>
                        <span>Algorithm</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/performance" class="nav-link">
                        <i class="fas fa-chart-line"></i>
                        <span>Performance</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a href="/contact" class="nav-link">
                        <i class="fas fa-envelope"></i>
                        <span>Contact</span>
                    </a>
                </div>
            </nav>

            <div class="sidebar-footer" style="padding: 1rem; background: rgba(0,0,0,0.1); border-radius: 0.5rem; margin-top: auto;">
                <p style="font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 700; margin-bottom: 0.5rem;">Security Status</p>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span style="width: 8px; height: 8px; background: #22c55e; border-radius: 50%; box-shadow: 0 0 10px #22c55e;"></span>
                    <span style="font-size: 0.875rem;">Shield Active</span>
                </div>
            </div>
        </aside>
        <% } %>

        <!-- Main Content Wrapper -->
        <main class="main-content">
            <% if (typeof hideTopBar === 'undefined' || !hideTopBar) { %>
            <header class="top-bar">
                <div>
                    <h1 style="font-size: 1.25rem; font-weight: 700;"><%= typeof title !== 'undefined' ? title : 'System Overview' %></h1>
                    <p style="font-size: 0.65rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em;">Horspool String Matching Engine</p>
                </div>
                <div class="user-pill" style="display: flex; align-items: center; gap: 1rem; padding: 0.5rem 1rem; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 2rem;">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <div class="user-avatar" style="width: 32px; height: 32px; background: var(--accent-indigo); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem;">
                            <%= user.name.charAt(0) %>
                        </div>
                        <div style="line-height: 1.2;">
                            <p style="font-size: 0.875rem; font-weight: 600;"><%= user.name %></p>
                            <p style="font-size: 0.75rem; color: var(--text-secondary); text-transform: initial;"><%= user.email %></p>
                        </div>
                    <% } %>
                </div>
                <div style="margin-left: 1rem;">
                    <button class="theme-toggle-btn" id="theme-toggle" title="Toggle Theme">
                        <i class="fas fa-moon"></i>
                    </button>
                </div>
            </header>
            <% } %>
            <div class="content-body" style="padding: <%= (typeof hideSidebar !== 'undefined' && hideSidebar) ? '0' : '2rem' %>; flex: 1;">
