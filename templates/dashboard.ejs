<%- include('header', {title: 'Security Operations Center'}) %>

<div class="animate-fade">
    <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h2 style="font-size: 1.5rem; font-weight: 800; letter-spacing: -0.025em;">Operations Overview</h2>
            <p style="font-size: 0.875rem; color: var(--text-secondary);">Real-time monitoring of detection nodes and pattern signatures</p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <button class="btn btn-outline" onclick="window.print()" style="font-size: 0.8125rem;">
                <i class="fas fa-print"></i>
            </button>
            <a href="/detector" class="btn btn-primary">
                <i class="fas fa-plus"></i> New Command
            </a>
        </div>
    </div>

    <!-- Stats Overview -->
    <div class="stats-grid">
        <div class="card glass stat-item" style="box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 0 20px rgba(6, 182, 212, 0.05);">
            <p class="stat-label">Scan Volume</p>
            <h3 class="stat-value"><%= stats.total %></h3>
            <div class="progress-container">
                <div class="progress-fill" style="width: 100%; background: var(--accent-cyan);"></div>
            </div>
        </div>
        <div class="card glass stat-item" style="box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 0 20px rgba(239, 68, 68, 0.05);">
            <p class="stat-label">Threats Logged</p>
            <h3 class="stat-value" style="color: #ef4444;"><%= stats.spam_count || 0 %></h3>
            <div class="progress-container">
                <div class="progress-fill" style="width: <%= stats.total > 0 ? ((stats.spam_count || 0) / stats.total) * 100 : 0 %>%; background: #ef4444;"></div>
            </div>
        </div>
        <div class="card glass stat-item">
            <p class="stat-label">System Performance</p>
            <h3 class="stat-value" style="color: #22c55e;">99.8%</h3>
            <div class="progress-container">
                <div class="progress-fill" style="width: 99.8%; background: #22c55e;"></div>
            </div>
        </div>
        <div class="card glass stat-item">
            <p class="stat-label">Avg Latency</p>
            <h3 class="stat-value" style="color: var(--accent-indigo);"><%= Number(stats.avg_speed || 0).toFixed(2) %>ms</h3>
            <div class="progress-container">
                <div class="progress-fill" style="width: 40%; background: var(--accent-indigo);"></div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="detector-wrap" style="margin-bottom: 2rem;">
        <div class="card glass" style="flex: 1;">
            <h4 style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 1.5rem; letter-spacing: 0.05em;">Security Activity Timeline</h4>
            <div style="height: 250px;">
                <canvas id="timelineChart"></canvas>
            </div>
        </div>
        <div class="card glass" style="width: 320px;">
            <h4 style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 1.5rem; letter-spacing: 0.05em;">Threat Vector Analysis</h4>
            <div style="height: 200px;">
                <canvas id="threatChart"></canvas>
            </div>
            <div style="margin-top: 1rem; display: flex; justify-content: center; gap: 1.5rem; font-size: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem;"><span style="width: 10px; height: 10px; border-radius: 2px; background: #ef4444;"></span> Spam</div>
                <div style="display: flex; align-items: center; gap: 0.5rem;"><span style="width: 10px; height: 10px; border-radius: 2px; background: #22c55e;"></span> Safe</div>
            </div>
        </div>
    </div>

    <div class="detector-wrap">
        <!-- Recent History -->
        <div class="card glass" style="background: rgba(30, 41, 59, 0.4);">
            <h3 style="margin-bottom: 1.5rem; font-size: 1.125rem; font-weight: 700; display: flex; align-items: center; gap: 0.75rem;">
                <i class="fas fa-clock-rotate-left" style="color: var(--accent-cyan);"></i> Transmission History
            </h3>
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Protocol/Subject</th>
                            <th>Integrity</th>
                            <th>Risk</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentHistory.length > 0) { %>
                            <% recentHistory.forEach(item => { %>
                                <tr>
                                    <td style="font-weight: 600; font-family: 'JetBrains Mono', monospace; font-size: 0.875rem;"><%= item.subject %></td>
                                    <td>
                                        <span style="display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.25rem 0.75rem; border-radius: 1rem; font-size: 0.7rem; font-weight: 700; background: <%= item.is_spam ? 'rgba(239, 68, 68, 0.1)' : 'rgba(34, 197, 94, 0.1)' %>; color: <%= item.is_spam ? '#ef4444' : '#22c55e' %>;">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span>
                                            <%= item.is_spam ? 'BLOCKED' : 'VERIFIED' %>
                                        </span>
                                    </td>
                                    <td><b style="color: <%= item.spam_score > 50 ? '#ef4444' : 'var(--text-primary)' %>; font-size: 0.875rem;"><%= item.spam_score %>%</b></td>
                                    <td style="color: var(--text-secondary); font-size: 0.75rem; font-family: monospace;">
                                        <%= new Date(item.created_at).toLocaleString() %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 4rem; color: var(--text-secondary);">
                                    <i class="fas fa-terminal" style="font-size: 2.5rem; display: block; margin-bottom: 1rem; opacity: 0.1;"></i>
                                    System initialized. Waiting for incoming transmissions.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- System Alerts / Status -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div class="card glass" style="background: linear-gradient(135deg, rgba(34, 197, 94, 0.05), rgba(6, 182, 212, 0.05)); border: 1px dashed rgba(6, 182, 212, 0.3);">
                <div style="display: flex; align-items: flex-start; gap: 1rem;">
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: rgba(34, 197, 94, 0.1); color: #22c55e; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <i class="fas fa-shield-check"></i>
                    </div>
                    <div>
                        <h4 style="font-size: 0.875rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem;">Security Protocol Active</h4>
                        <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.5;">Horspool Engine v2.4 initialized with 12 global spam patterns. All nodes online.</p>
                    </div>
                </div>
                <div style="margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div>
                        <p style="font-size: 0.65rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 700;">Uptime</p>
                        <p style="font-size: 0.8125rem; font-weight: 600; color: #22c55e;">99.998%</p>
                    </div>
                    <div>
                        <p style="font-size: 0.65rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 700;">Encryption</p>
                        <p style="font-size: 0.8125rem; font-weight: 600; color: var(--accent-cyan);">AES-256</p>
                    </div>
                </div>
            </div>

            <div class="card glass" style="background: rgba(99, 102, 241, 0.05);">
                <h4 style="font-size: 0.75rem; font-weight: 700; color: var(--accent-indigo); text-transform: uppercase; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                    <i class="fas fa-bolt"></i> Quick Tactics
                </h4>
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    <button class="btn btn-outline" style="justify-content: flex-start; padding: 0.75rem; font-size: 0.75rem;" onclick="location.href='/performance'">
                        <i class="fas fa-gauge"></i> Efficiency Report
                    </button>
                    <button class="btn btn-outline" style="justify-content: flex-start; padding: 0.75rem; font-size: 0.75rem;" onclick="location.href='/algorithm'">
                        <i class="fas fa-code"></i> Patch Patterns
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Timeline Chart
    const lineCtx = document.getElementById('timelineChart').getContext('2d');
    new Chart(lineCtx, {
        type: 'line',
        data: {
            labels: <%- JSON.stringify(charts.timeline.map(t => t.date)) %>,
            datasets: [{
                label: 'Scans',
                data: <%- JSON.stringify(charts.timeline.map(t => t.count)) %>,
                borderColor: '#6366f1',
                backgroundColor: 'rgba(99, 102, 241, 0.05)',
                borderWidth: 3,
                tension: 0.4,
                pointRadius: 4,
                pointBackgroundColor: '#6366f1',
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { display: false, beginAtZero: true },
                x: { grid: { display: false }, ticks: { color: 'rgba(255,255,255,0.3)', font: { size: 10 } } }
            }
        }
    });

    // Threat Distribution Pie
    const pieCtx = document.getElementById('threatChart').getContext('2d');
    new Chart(pieCtx, {
        type: 'doughnut',
        data: {
            labels: ['Spam', 'Safe'],
            datasets: [{
                data: [<%= charts.distribution.spam || 0 %>, <%= charts.distribution.safe || 0 %>],
                backgroundColor: ['#ef4444', '#22c55e'],
                borderWidth: 0,
                cutout: '80%'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } }
        }
    });
</script>

<%- include('footer') %>
