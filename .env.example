# ==========================================
# SPAMSHIELD SYSTEM WIDE ENVIRONMENT CONFIG
# ==========================================

# --- BACKEND SERVICES (Express & Mongoose) ---
# Port for the API server (e.g. 3000 in local development, or auto-configured on Render)
PORT=3000

# Secret key for JWT session tokens (use a long random string in production)
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Atlas connection string (obtain this from the Atlas Dashboard under "Connect")
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/spamshield?retryWrites=true&w=majority


# --- FRONTEND CLIENT (Vite & React) ---
# URL pointing to the running backend service. 
# Make sure to set this to the Render backend URL when deploying frontend to Vercel.
VITE_API_URL=http://localhost:3000
